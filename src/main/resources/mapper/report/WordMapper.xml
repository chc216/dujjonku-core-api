<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.core.word.mapper.WordMapper">

    <select id="findById" resultType="com.example.core.word.reportdto.WordInfoMapperDto">
        SELECT
            id,
            name,
            meaning,
            example
        FROM word
        WHERE id = #{id}
    </select>

</mapper>